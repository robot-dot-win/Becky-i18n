#include <windows.h>

// 本文件由 CMake 从 version.rc.in 配置生成，请勿手工编辑。
// 版本号与版权信息的唯一来源是顶层 CMakeLists.txt。

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS @BKI_RC_FILEFLAGS@ | 0x1L
#else
 FILEFLAGS @BKI_RC_FILEFLAGS@
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Martin Young"
            VALUE "FileDescription",  "Multi-language localization plug-in for Becky! Internet Mail"
            VALUE "FileVersion",      "@BECKY_VERSION_FULL@"
            VALUE "InternalName",     "locale"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Martin Young. Licensed under the MIT License."
            VALUE "OriginalFilename", "locale.dll"
            VALUE "ProductName",      "Becky! I18n"
            VALUE "ProductVersion",   "@BECKY_VERSION_FULL@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
