#pragma once

// 本文件由 CMake 从 src/version.hpp.in 生成，请勿手工编辑。
// 版本号唯一来源是顶层 CMakeLists.txt 的 project(VERSION) 与 BECKY_VERSION_SUFFIX。

namespace bki18n::version {

inline constexpr int kMajor = @PROJECT_VERSION_MAJOR@;
inline constexpr int kMinor = @PROJECT_VERSION_MINOR@;
inline constexpr int kPatch = @PROJECT_VERSION_PATCH@;

// 预发布后缀（不含前导连字符），正式发布为空字符串
inline constexpr const char* kSuffix = "@BECKY_VERSION_SUFFIX@";

// 完整语义版本，如 "1.0.0" 或 "1.0.0-rc.1"
inline constexpr const char* kVersion = "@BECKY_VERSION_FULL@";
inline constexpr const wchar_t* kVersionW = L"@BECKY_VERSION_FULL@";

}  // namespace bki18n::version
